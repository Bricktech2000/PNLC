# the missing instances are located at the beginning of the section because many
# `Enum` instances depend on them.
#
# no need for `Monoid (List a)`, it'd be isomorphic to `Alternative f =>
# Monoid (Alt f a)` for `f ~ List`
..def .uneq \elemequal .eq
  .fix \listequal \rhs \lhs
    .\conscons ..rhs
      ..lhs conscons \head \tail false
      ..lhs \head \tail false true
    \lhshead \lhstail \rhshead \rhstail ..and
      ..elemequal rhshead lhshead
      ..listequal rhstail lhstail
\list:eq
..def .unord \elem:eq \elemcompare ..ord
  .list:eq elem:eq
  .fix \listcompare \rhs \lhs
    .\conscons ..rhs
      ..lhs conscons \head \tail lt
      ..lhs \head \tail gt et
    \lhshead \lhstail \rhshead \rhstail ..telse
      ..elemcompare rhshead lhshead
      ..listcompare rhstail lhstail
\list:ord
..def \elem:bndd ..bndd .fix .cons .top elem:bndd nil \list:bndd
..def .undbg \elemdebug .dbg
