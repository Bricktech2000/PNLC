..def ..cata listf:ftor ..list \head \acc .some ..acc id head none \last
..def ..cata listf:ftor ..list \head \acc .some ..acc .cons head nil none \init
# rev list = appEndo (getDual (foldMap (Dual . Endo . cons) list)) nil
..def \list ...fold .dual:mnid endo:mnid ...fmap list:ftor cons list nil \rev
..def \elem ..ana natf:ftor ..opt .cons elem nil \replicate
# cons the element onto the sorted list and `insert` will scooch it over
..def \elem:ord ..apo listf:ftor ...cardinal list nil
  \head \tail ..tail
    \headtail \tailtail
      ...isgt ...compare elem:ord headtail head
        ..cons headtail .ok ..cons head tailtail
        ..cons head .err tail
    ..cons head .err tail
\insert
