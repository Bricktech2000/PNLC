# `type DList a = List a -> List a`
# difference lists. a difference list is a function which, when given a tail,
# prepends the list it represents to that tail. concatenation of difference
# lists is function composition, which is constant time. `tolist` and `todlist`
# are linear time. see 'A Novel Representation of Lists and its Application to
# the Function "Reverse"' by John Hughes, 1986
..def .dove cons \dcons
..def id \dnil
..def ..cardinal blackbird cons \dsnoc
..def ..cata listf:ftor ..list dcons dnil \todlist
# no need for `Monoid (DList a)`, it'd be isomorphic to `Alternative f =>
# Monoid (Alt f a)` and to `Monoid (Endo (f a))` for `f ~ DList`
..def .ftor
  \func \dlistarg
    ...cata listf:ftor ..list ..bluebird dcons func dnil .dlistarg nil
\dlist:ftor
..def ...aptv
  dlist:ftor
  \val .cons val
  \dlistfunc \dlistarg ...cata listf:ftor
    ..list .dove ..cardinal .fmap dlist:ftor dlistarg dnil
    .dlistfunc nil
\dlist:aptv
..def ..mnad
  dlist:aptv
  \dlistarg \func
    ...cata listf:ftor ..list .dove func dnil .dlistarg nil
\dlist:mnad
..def ...altv dlist:aptv dnil bluebird \dlist:altv
..def .fldb .thrush nil \dlist:fldb
..def ...tvsb
  dlist:ftor
  dlist:fldb
  \elem:aptv \dlistaptv
    ...cata listf:ftor ..list
      ..lifta2 elem:aptv dcons
      ..pure elem:aptv dnil
    .dlistaptv nil
\dlist:tvsb
..def \elem:eq .eq
  \rhs \lhs ...equal .list:eq elem:eq .rhs nil .lhs nil
\dlist:eq
..def \elem:ord ..ord
  .dlist:eq .ord:eq elem:ord
  \rhs \lhs ...compare .list:ord elem:ord .rhs nil .lhs nil
\dlist:ord
..def \elem:bndd ..bndd .fix .dcons .top elem:bndd dnil \dlist:bndd
..def \elem:dbg \dlist ..debug .list:dbg elem:dbg .dlist nil \dlist:dbg
..def \elem:seq \dlist ..force .list:seq elem:seq .dlist nil \dlist:seq
..def .unenum \elemenumerate .enum
  .fix \dlistenumerate ..dcons nil
    ....lifta2 list:aptv .cardinal dcons dlistenumerate elemenumerate
\dlist:enum
# `type DShort a = Down (DList (Down a))`
# the ordering where shorter dlists compare greater than longer dlists and where
# `DNil` is the top element instead of the bottom element
..def \elem:ord .down:ord .dlist:ord .down:ord elem:ord \dshort:ord
..def \elem:bndd .down:bndd .dlist:bndd .down:bndd elem:bndd \dshort:bndd
..def \elem:enum .down:enum .dlist:enum .down:enum elem:enum \dshort:enum

# type Tape a = Pair a (Sqr (Stream a))
# pairs all the way down!
..def .unpair \head .unpair \left \right .right \fst \snd
  ..pair fst ..pair ..pair head left snd
\leftshift
..def .unpair \head .unpair \left \right .left \fst \snd
  ..pair fst ..pair snd ..pair head right
\rightshift
..def \elem:eq .eq
  ..psi .equal ..pair:eq elem:eq .stream:eq .sqr:eq elem:eq
    ..fmap paira:ftor ..sequence sqr:tvsb stream:aptv
\tape:eq
..def \elem:ord ..ord
  tape:eq
  ..psi .compare ..pair:ord elem:ord .stream:ord .sqr:ord elem:ord
    ..fmap paira:ftor ..sequence sqr:tvsb stream:aptv
\tape:ord
..def \elem:bndd
  ..pair:bndd elem:bndd .sqr:bndd .stream:bndd elem:bndd
\tape:bndd
..def \radius .undbg \elemdebug .dbg
  .unpair \head .unpair \left \right ...becard
    ..fold .dual:mnid endo:mnid
      ...fmap list:ftor \elem ..bluebird .elemdebug elem :]
        ..stake radius left
    .elemdebug head
    ..fold endo:mnid
      ...fmap list:ftor \elem ..bluebird :[ .elemdebug elem
        ..stake radius right
\tape:dbg
..def \elem:seq
  ..pair:seq elem:seq .sqr:seq .stream:seq seq
\tape:seq # never terminates
..def \tails:enum1 \elem:enum
  ..pair:enum elem:enum .enum
    ...fmap list:ftor ..distribute sqr:dstv stream:ftor
      .enumerate ..stream:enum tails:enum1 .sqr:enum elem:enum
\tape:enum
..def \elem:sgrp
  ..pair:sgrp elem:sgrp ..ap:sgrp sqr:aptv .stream:sgrp elem:sgrp
\tape:sgrp
..def \elem:mnid
  ..pair:mnid elem:mnid ..ap:mnid sqr:aptv .stream:mnid elem:mnid
\tape:mnid
..def .ftor
  \func .unpair \headarg \sqrarg
    ..pair .func headarg ...fmap sqr:ftor ..fmap stream:ftor func sqrarg
\tape:ftor
..def ...aptv
  tape:ftor
  \val ..pair val ..pure sqr:aptv ..pure stream:aptv val
  .unpair \headfunc \sqrfunc .unpair \headarg \sqrarg
    ..pair .headfunc headarg
      ....lifta2 sqr:aptv .apply stream:aptv sqrfunc sqrarg
\tape:aptv
..def ..mnad
  tape:aptv
  .unpair \headarg .unpair \leftarg \rightarg \func
    ..pair .fst .func headarg ..pair
      ...bind stream:mnad  leftarg ...becard fst snd func
      ...bind stream:mnad rightarg ...becard snd snd func
\tape:mnad
..def ...cmnd
  tape:ftor
  \tapeval .fst tapeval
  \func \arg
    ..pair .func arg ..pair
      ...fmap stream:ftor func .snd ..iterate rightshift arg
      ...fmap stream:ftor func .snd ..iterate  leftshift arg
\tape:cmnd
..def .fldb
  .unpair \head \sqr
    ..cons head
      ...cardinal .bind list:mnad .tolist sqr:fldb
        ..tolist stream:fldb
          ...sequence sqr:tvsb stream:aptv sqr
\tape:fldb
..def ...tvsb
  tape:ftor
  tape:fldb
  \elem:aptv .unpair \head \sqr
    ....lifta2 elem:aptv cons head
      ...sequence stream:tvsb elem:aptv
        ...fmap stream:ftor
          ..sequence sqr:tvsb elem:aptv
          ...sequence sqr:tvsb stream:aptv sqr
\tape:tvsb
..def ..dstv
  tape:ftor
  \outer:ftor .outer:ftor \outerfmap \ftortape
    ..pair ..outerfmap fst ftortape
      ...fmap sqr:ftor
        ..distribute stream:dstv outer:ftor
        ...distribute sqr:dstv outer:ftor
          ..outerfmap snd ftortape
\tape:dstv

# the "base" functor for `Free`, with the property `Fix (FreeF f a) ~=
# Free f a`. `data FreeF f a r = Roll (f r) | Return a deriving Functor`
..def .unftor \termfmap .ftor
  \func ..free
    ..bluebird roll .termfmap func
    return
\freef:ftor
..def \term:ftor .ftor
  \func ..cata .freef:ftor term:ftor ..free roll ..bluebird return func
\free:ftor
..def \term:ftor ...aptv
  .free:ftor term:ftor
  \val .return val
  \freefunc \freearg
    ...cata .freef:ftor term:ftor ..free roll
        ..cardinal .fmap .free:ftor term:ftor freearg
      freefunc
\free:aptv
..def \term:ftor ..mnad
  free:aptv
  \freearg \func ...cata .freef:ftor term:ftor ..free roll func freearg
\free:mnad
# instance Foldable f => Foldable (Free f)
..def .unfldb \termtolist .fldb
  # using `fix` instead of `cata` to save us requiring `term:ftor`
  .fix \freetolist ..free
    ..bluebird ..bind list:ftor freetolist termtolist
    .pure list:aptv
\free:fldb
# instance Traversable f => Traversable (Free f)
# sequence :: Applicative p => Free f (p a) -> p (Free f a)
..def .untvsb \term:ftor \term:fldb \termsequence ...tvsb
  .free:ftor term:ftor
  .free:fldb term:fldb
  \elem:aptv ..cata .freef:ftor term:ftor ..free
    ..bluebird ..fmap .aptv:ftor elem:aptv roll .termsequence elem:aptv
    ..fmap .aptv:ftor elem:aptv return
\free:tvsb
# `term:eq1` is a function that takes an `elem:eq` (an equality for the element
# type) and returns a `term:eq` (an equality for the collection). `term:ord1`
# works the same.
..def \term:eq1 .uneq \varequal .fix \free:eq .eq
  \rhs \lhs ..rhs
    ..lhs .equal .term:eq1 free:eq .kestrel false
    ..lhs .kestrel false varequal
\free:eq
..def \term:ord1 .unord \var:eq \varcompare .fix \free:ord ..ord
  ..free:eq ..bluebird ord:eq term:ord1 var:eq
  \rhs \lhs ..rhs
    ..lhs .compare .term:ord1 free:ord .kestrel lt
    ..lhs .kestrel gt varcompare
\free:ord
..def \term:ftor \term:dbg1 .undbg \vardebug
  ..term:dbg1 dbgged:dbg \termdebug .dbg
    ..cata .freef:ftor term:ftor ..free
      ..blackbird :@ termdebug
      ..blackbird :$ vardebug
\free:dbg
..def \term:ftor \term:seq1 .unseq \varforce
  ..term:seq1 forced:seq \termforce .seq
    ..cata .freef:ftor term:ftor ..free termforce varforce
\free:seq
..def \term:enum1 .unenum \varenumerate .fix \free:enum .enum
  ...alt list:altv
    ...fmap list:ftor return varenumerate
    ...fmap list:ftor roll .enumerate .term:enum1 free:enum
\free:enum
# liftF :: Functor f => f a -> Free f a
# retract :: Monad f => Free f a -> f a
# hoistFree :: Functor f => (forall a. f a -> g a) -> Free f b -> Free g b
..def .unftor \termfmap
  ..bluebird roll .termfmap pure
\liftf
..def \term:mnad
  # in the `Roll` case we receive an `f r` where `r` is the carrier type, and
  # the carrier type itself is an `f a`, so we call `join :: f (f a) -> f a`
  ..cata .freef:ftor .aptv:ftor .mnad:aptv term:mnad ..free
    .join term:mnad
    .pure .mnad:aptv term:mnad
\retract
..def \term:ftor \func
  ..cata .freef:ftor term:ftor ..free
    ..bluebird roll func
    return
\hoistfree
# no need for `foldFree`, it'd be equivalent to `.cata freef:ftor`.
# no need for `unfoldFree`, it'd be equivalent to `.ana freef:ftor`.
# no need for `iter` and `iterA`, they'd be trivial wrappers around the above

# the "base" functor for `Cofree`, with the property `Fix (CofreeF f a) ~=
# Cofree f a`. `data CofreeF f a r = Cofree (f r) a deriving Functor`
..def .unftor \tracefmap .ftor
  \func .uncofree ..bluebird cofree .tracefmap func
\cofreef:ftor
..def \trace:eq1 .uneq \annequal .fix \cofree:eq .eq
  .uncofree \rhstrace \rhsann .uncofree \lhstrace \lhsann ..and
    ..annequal rhsann lhsann
    ...equal .trace:eq1 cofree:eq rhstrace lhstrace
\cofree:eq
..def \trace:ord1 .unord \ann:eq \anncompare .fix \cofree:ord ..ord
  ..cofree:eq ..bluebird ord:eq trace:ord1 ann:eq
  .uncofree \rhstrace \rhsann .uncofree \lhstrace \lhsann ..telse
    ..anncompare rhsann lhsann
    ...compare .trace:ord1 cofree:ord rhstrace lhstrace
\cofree:ord
..def \trace:ftor \trace:dbg1 .undbg \anndebug
  ..trace:dbg1 dbgged:dbg \tracedebug .dbg
    ..cata .cofreef:ftor trace:ftor .uncofree
      \trace \ann ...becard .tracedebug trace :@ .anndebug ann
\cofree:dbg
..def \trace:ftor \trace:seq1 .unseq \annforce
  ..trace:seq1 forced:seq \traceforce .seq
    ..cata .cofreef:ftor trace:ftor .uncofree
      \trace \ann ..bluebird .traceforce trace .annforce ann
\cofree:seq
..def \trace:enum1 .unenum \annenumerate .fix \cofree:enum .enum
  ....lifta2 list:aptv cofree .enumerate .trace:enum1 cofree:enum annenumerate
\cofree:enum
..def \trace:ftor .ftor
  \func ..cata .cofreef:ftor trace:ftor .uncofree
    \trace \ann ..cofree trace .func ann
\cofree:ftor
..def \trace:altv
  ..def .aptv:ftor .altv:aptv trace \trace:ftor
  ...aptv
    .cofree:ftor trace:ftor
    \val ..cofree .empty .altv:aptv trace:altv val
    \cofreefunc \cofreearg
      ...cata .cofreef:ftor trace:ftor .uncofree
        \trace \ann ....fmap .cofree:ftor trace:ftor ann cofreearg
          \traceret \annret ..cofree ...alt trace:altv traceret trace annret
      cofreefunc
\cofree:aptv
..def \trace:altv
  ..def .aptv:ftor .altv:aptv trace \trace:ftor
  ..mnad
    .cofree:aptv .altv:aptv trace:altv
    \cofreearg \func
      ...cata .cofreef:ftor trace:ftor .uncofree
        \trace \ann ..func ann
          \traceret \annret ..cofree ...alt trace:altv traceret trace annret
      cofreearg
\cofree:mnad
..def \trace:ftor ...cmnd
  .cofree:ftor trace:ftor
  \cofreeval .ann cofreeval
  \func ..para .cofreef:ftor trace:ftor .uncofree
    .unpair \trace \acc \ann ..cofree .func ..cofree trace ann acc
\cofree:cmnd
# instance Foldable f => Foldable (Cofree f)
..def .unfldb \tracetolist .fldb
  # using `fix` instead of `cata` to save us requiring `trace:ftor`
  .fix \cofreetolist .uncofree \trace \ann
    ..cons ann ...bind list:ftor cofreetolist .tracetolist trace
\cofree:fldb
# instance Traversable f => Traversable (Cofree f)
# sequence :: Applicative p => Cofree f (p a) -> p (Cofree f a)
..def .untvsb \trace:ftor \trace:fldb \tracesequence ...tvsb
  .cofree:ftor trace:ftor
  .cofree:fldb trace:fldb
  \elem:aptv ..cata .cofreef:ftor trace:ftor .cofree
    \trace \ann ...fmap .aptv:ftor elem:aptv
      ..cardinal cofree ann
      ..tracesequence elem:aptv trace
\cofree:tvsb
# instance Distributive f => Distributive (Cofree f)
# distribute :: Functor g => g (Cofree f a) -> Cofree f (g a)
..def .undstv \trace:ftor \tracedistribute ..dstv
  .cofree:ftor trace:ftor
  \outer:ftor .outer:ftor \outerfmap
    ..ana .cofreef:ftor trace:ftor \seed ..cofree
      ..tracedistribute outer:ftor ..outerfmap trace seed
      ..outerfmap ann seed
\cofree:dstv

..def .ftor
  \func .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7
    ........oct
      .func a0
      .func a1
      .func a2
      .func a3
      .func a4
      .func a5
      .func a6
      .func a7
\oct:ftor
..def ...aptv
  oct:ftor
  \val ........oct val val val val val val val val
  .unoct \f0 \f1 \f2 \f3 \f4 \f5 \f6 \f7
    .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7
      ........oct
        .f0 a0
        .f1 a1
        .f2 a2
        .f3 a3
        .f4 a4
        .f5 a5
        .f6 a6
        .f7 a7
\oct:aptv
..def ..mnad
  oct:aptv
  .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7 \func
    ........oct
      .oct.0 .func a0
      .oct.1 .func a1
      .oct.2 .func a2
      .oct.3 .func a3
      .oct.4 .func a4
      .oct.5 .func a5
      .oct.6 .func a6
      .oct.7 .func a7
\oct:mnad
..def .fldb
  .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7
    ..cons a0
    ..cons a1
    ..cons a2
    ..cons a3
    ..cons a4
    ..cons a5
    ..cons a6
    ..cons a7
    nil
\oct:fldb
..def ...tvsb
  oct:ftor
  oct:fldb
  \elem:aptv .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7
    ..def .cardinal .apply elem:aptv \capply
    ..capply a7
    ..capply a6
    ..capply a5
    ..capply a4
    ..capply a3
    ..capply a2
    ..capply a1
    ..capply a0
    ..pure elem:aptv oct
\oct:tvsb
..def ..dstv
  oct:ftor
  .unftor \outerfmap \ftoroct
    ........oct
      ..outerfmap oct.0 ftoroct
      ..outerfmap oct.1 ftoroct
      ..outerfmap oct.2 ftoroct
      ..outerfmap oct.3 ftoroct
      ..outerfmap oct.4 ftoroct
      ..outerfmap oct.5 ftoroct
      ..outerfmap oct.6 ftoroct
      ..outerfmap oct.7 ftoroct
\oct:dstv
..def \func \zero .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7
  ..func
    ..func
      ..func
        ..func
          ..func
            ..func
              ..func
                ..func
                  zero
                  a0
                a1
              a2
            a3
          a4
        a5
      a6
    a7
\oct.foldl
..def \func \zero .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7
  ..func a0
    ..func a1
      ..func a2
        ..func a3
          ..func a4
            ..func a5
              ..func a6
                ..func a7
                  zero
\oct.foldr
..def .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7
  ........oct a7 a6 a5 a4 a3 a2 a1 a0
\oct.rev
..def .uneq \elemequal .eq
  \rhs \lhs ..fold and:mnid ..tolist oct:fldb
    ....lifta2 oct:aptv elemequal rhs lhs
\oct:eq
..def .unord \elem:eq \elemcompare ..ord
  .oct:eq elem:eq
  \rhs \lhs ..fold tnles:mnid ..tolist oct:fldb
    ....lifta2 oct:aptv elemcompare rhs lhs
\oct:ord
..def .unbndd \elemtop \elembot ..bndd
  ..pure oct:aptv elemtop
  ..pure oct:aptv elembot
\oct:bndd
..def .undbg \elemdebug .dbg
  \oct ..fold .dual:mnid endo:mnid ..tolist oct:fldb
    ...fmap oct:ftor elemdebug oct
\oct:dbg
..def .unseq \elemforce .seq
  \oct ..fold endo:mnid ..tolist oct:fldb
    ...fmap oct:ftor elemforce oct
\oct:seq
..def .unenum \elemenumerate .enum
  ...fmap list:ftor oct.rev
    ...sequence oct:tvsb list:aptv
      ..pure oct:aptv elemenumerate
