..def .oct:eq bool:eq \u8:eq
..def .oct:ord bool:ord \u8:ord
..def .oct:bndd bool:bndd \u8:bndd
..def .oct:dbg bool:dbg \u8:dbg
..def .oct:seq bool:seq \u8:seq
..def .oct:enum bool:enum \u8:enum
..def .dbg
  .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7
    .\nibble ..bluebird
      ....nibble a7 a6 a5 a4
      ....nibble a3 a2 a1 a0
    \n3 \n2 \n1 \n0 ..n3
      ..n2 ..n1 ..n0 :f :e ..n0 :d :c ..n1 ..n0 :b :a ..n0 :9 :8
      ..n2 ..n1 ..n0 :7 :6 ..n0 :5 :4 ..n1 ..n0 :3 :2 ..n0 :1 :0
\u8.hex:dbg
# perform case analysis on each bit, examining any bit at most once. `and`,
# `or`, `blt` and `ble` are special cases of case analysis where one branch
# short-circuits, so we allow those too. memory aid:
#     `.and aN` --- it is necessary that aN be true
#     `.or  aN` --- it is sufficient that aN be true
#     `.blt aN` --- it is necessary that aN be false
#     `.ble aN` --- it is sufficient that aN be false
..def .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7
  ..blt a7 ..a6
    ..a4 # isalpha
      ..ble a3 ..blt a2 ..ble a1 ..ble a0 false
      ..or  a3 ..or  a2 ..or  a1 ..or  a0 false
    ..and a5 ..and a4 ..ble a3 ..blt a2 ..blt a1 true # isdigit
\isalnum
..def .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7
  ..blt a7 ..and a6 ..a4
    ..ble a3 ..blt a2 ..ble a1 ..ble a0 false
    ..or  a3 ..or  a2 ..or  a1 ..or  a0 false
\isalpha
..def .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7
  ..blt a7 ..blt a6 ..blt a4 ..blt a2 ..blt a1 ..a5
    ..blt a3 ..blt a0 true
    ..and a3 ..and a0 true
\isblank
..def .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7
  ..blt a7 ..a6
    ..and a5 ..and a4 ..and a3 ..and a2 ..and a1 ..and a0 true
    ..blt a5 ..blt a4 ..blt a3 ..blt a2 ..blt a1 ..blt a0 true # !isprint
\iscntrl
..def .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7
  ..blt a7 ..blt a6 ..and a5 ..and a4 ..ble a3 ..blt a2 ..blt a1 true
\isdigit
..def .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7
  ..blt a7 ..a6
    ..ble a5 ..ble a4 ..ble a3 ..ble a2 ..ble a1 ..ble a0 false # isprint
    ..and a5 ..or  a4 ..or  a3 ..or  a2 ..or  a1 ..or  a0 false
\isgraph
..def .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7
  ..blt a7 ..and a6 ..and a5 ..a4
    # isalpha
    ..ble a3 ..blt a2 ..ble a1 ..ble a0 false
    ..or  a3 ..or  a2 ..or  a1 ..or  a0 false
\islower
..def .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7
  ..blt a7 ..a6
    ..ble a5 ..ble a4 ..ble a3 ..ble a2 ..ble a1 ..ble a0 false
    ..or  a5 false
\isprint
..def .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7
  ..blt a7 ..a6
    ..a4
      ..and a3 ..a5
        ..or  a2 ..and a1 ..and a0 true
        ..a2
          ..and a1 ..and a0 true
          ..ble a1 ..ble a0 false
      ..blt a3 ..blt a2 ..blt a1 ..blt a0 true
    ..and a5 ..a4
      ..and a3 ..or  a2 ..or  a1 false
      ..or  a3 ..or  a2 ..or  a1 ..or  a0 false
\ispunct
..def .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7
  ..blt a7 ..blt a6 ..blt a4 ..a5
    ..blt a3 ..blt a2 ..blt a1 ..blt a0 true
    ..and a3 ..a2
      ..blt a1 true
      ..or  a1 ..or  a0 false
\isspace
..def .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7
  ..blt a7 ..and a6 ..blt a5 ..a4
    # isalpha
    ..ble a3 ..blt a2 ..ble a1 ..ble a0 false
    ..or  a3 ..or  a2 ..or  a1 ..or  a0 false
\isupper
..def .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7
  ..blt a7 ..a6
    ..blt a4 ..blt a3 ..a2
      ..ble a1 ..ble a0 false
      ..or  a1 ..or  a0 false
    ..and a5 ..and a4 ..ble a3 ..blt a2 ..blt a1 true # isdigit
\isxdigit
..def .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7
  ..blt a7 true
\isascii
..def .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7
  ........oct a0 a1 a2 a3 a4 true  a6 a7
\mklower
..def .unoct \a0 \a1 \a2 \a3 \a4 \a5 \a6 \a7
  ........oct a0 a1 a2 a3 a4 false a5 a7
\mkupper
..def \chr ...isupper chr .mklower chr chr \tolower
..def \chr ...islower chr .mkupper chr chr \toupper
..def \c \rhs \lhs
  ...oct.foldl
    .unpair \c \oct .unpair \rhs \lhs ..pair
      ..or ..and c ..bne rhs lhs ..and rhs lhs
      .oct ..bne c ..bne rhs lhs
    ..pair c oct
    # ...sequence sqr:tvsb oct:aptv ..pair rhs lhs # works too
    ....lifta2 oct:aptv pair rhs lhs
\u8.addc
..def \b \rhs \lhs
  ...oct.foldl
    .unpair \b \oct .unpair \rhs \lhs ..pair
      ..or ..and b ..bne rhs .not lhs ..and rhs .not lhs
      .oct ..bne b ..bne rhs lhs
    ..pair b oct
    # ...sequence sqr:tvsb oct:aptv ..pair rhs lhs # works too
    ....lifta2 oct:aptv pair rhs lhs
\u8.subb
..def \c \arg
  ...oct.foldl
    .unpair \c \oct \cur ..pair
      ..and c cur
      .oct ..bne c cur
    ..pair c oct
    arg
\u8.incc
..def \b \arg
  ...oct.foldl
    .unpair \b \oct \cur ..pair
      ..and b .not cur
      .oct ..bne b cur
    ..pair b oct
    arg
\u8.decb
..def ..blackbird snd .u8.addc false \u8.add
..def ..blackbird snd .u8.subb false \u8.sub
..def ..bluebird snd .u8.incc true \u8.inc
..def ..bluebird snd .u8.decb true \u8.dec
..def .sgrp u8.add \u8.add:sgrp
..def ..mnid u8.add:sgrp $00 \u8.add:mnid

# type Fn a b = a -> b
#
# the environment monad, models computations that depend on a shared environment
..def .ftor bluebird \fna:ftor
..def ...aptv fna:ftor kestrel starling \fna:aptv # liftA2 = phi
..def ..mnad fna:aptv .cardinal violet \fna:mnad # join = warbler
..def .unmnid .unsgrp \argsappend \argmempty ...cmnd
  fna:ftor
  \fnaval .fnaval argmempty
  \func \arg ..bluebird func ..blackbird arg argsappend
\fna:cmnd
..def .unenum \argenumerate .fldb
  \fnaval ...fmap list:ftor fnaval argenumerate
\fna:fldb
..def \arg:eq \arg:enum .arg:enum \argenumerate ...tvsb
  fna:ftor
  .fna:fldb arg:enum
  # we need to turn a function returning an applicative into an applicative
  # holding a function... sounds impossible! the original applicative's effect
  # depends on the input to the function while the resulting applicative's
  # effect can't depend on anything. so what could that resulting effect
  # possibly be? it can only be one thing: the sequencing of every effect in
  # the function's image. so we call the function with every element of its
  # domain, cache the results in an associative list, sequence all effects
  # to the front, and respond to function calls using a cache lookup
  \ret:aptv \fnaptv
    ...fmap .aptv:ftor ret:aptv
      \assoc \arg ...opt id $err ...lookup arg:eq arg assoc
      ...sequence list:tvsb ret:aptv
        ...fmap list:ftor
          ...phi .fmap .aptv:ftor ret:aptv pair fnaptv
          argenumerate
\fna:tvsb
..def ..dstv
  fna:ftor
  .unftor \outerfmap
    \ftorfna \arg ..outerfmap .thrush arg ftorfna
\fna:dstv
..def .unenum \argenumerate .uneq \retequal .eq
  \rhs \lhs ..fold and:mnid
    ...fmap list:ftor ...phi retequal rhs lhs argenumerate
\fn:eq
..def \arg:enum .unord \ret:eq \retcompare .arg:enum \argenumerate ..ord
  ..fn:eq arg:enum ret:eq
  \rhs \lhs ..fold telse:mnid
    ...fmap list:ftor ...phi retcompare rhs lhs argenumerate
\fn:ord
..def .unbndd \rettop \retbot
  ..bndd .kestrel rettop .kestrel retbot
\fn:bndd
..def .unenum \argenumerate .undbg \argdebug .undbg \retdebug .dbg
  \fn ..fold endo:mnid
    ...fmap list:ftor
      \arg ..bluebird ...becard .argdebug arg := .retdebug .fn arg :;
      argenumerate
\fn:dbg
..def .unenum \argenumerate .unseq \retforce .seq
  \fn ..fold endo:mnid
    ...fmap list:ftor ..bluebird retforce fn argenumerate
\fn:seq
# here we call `sequence` on a concrete function returning superpositions of
# values to get a superposition of functions returning concrete values
..def \arg:eq \arg:enum .unenum \retenumerate .enum
  ...sequence ..fna:tvsb arg:eq arg:enum list:aptv
    .kestrel retenumerate
\fn:enum
..def .unsgrp \retsappend .sgrp
  \lhs \rhs ...phi retsappend lhs rhs
\fna:sgrp
..def .unmnid \ret:sgrp \retmempty ..mnid
  .fna:sgrp ret:sgrp
  retmempty
\fna:mnid

# type String = List U8
# type Parser a = String -> Maybe (Pair a String)
..def .ftor
  \func \parserarg
    ...fmap fna:ftor ..fmap opt:ftor ..fmap swapa:ftor func parserarg
\parser:ftor
..def ...aptv
  parser:ftor
  \val ...fmap fna:ftor .pure opt:aptv .pair val
  \parserfunc \parserarg
    \inp ...bind opt:mnad .parserfunc inp
      .unpair \func ...fmap parser:ftor func parserarg
\parser:aptv
..def ..mnad
  parser:aptv
  \parserarg \func
    \inp ...bind opt:mnad .parserarg inp .unpair func
\parser:mnad
..def ...altv
  parser:aptv
  \inp .pure opt:altv
  ..lifta2 fna:aptv .alt opt:altv
\parser:altv
..def \pred ...cardinal list none
  \head \tail ...not .pred head none
    .some ..pair head tail
\satp
..def ..list
  \head \tail none
  .some ..pair unit nil
\eofp
..def ..bluebird satp .bluebird not \unsatp
..def ..bluebird satp .equal u8:eq \chrp
..def ..bluebird satp .unequal u8:eq \nonchrp
..def .satp .kestrel true \getp
..def ..bluebird
  ..sequence list:tvsb parser:aptv
  ..fmap list:ftor chrp
\strp

# an `IO a` is a function that takes a continuation and returns "$" functions
# wrapping the application of the continuation to a value of type `a`.
#
# no need for `Monoid a => Monoid (IO a)`, it'd be isomorphic to
# `(Applicative f, Monoid a) => Monoid (Ap f a)` for `f ~ IO`
..def .ftor
  \func \ioarg \cont .ioarg \arg .cont .func arg
\io:ftor
..def ...aptv
  io:ftor
  \val \cont .cont val
  \iofunc \ioarg \cont .iofunc \func ....fmap io:ftor func ioarg cont
\io:aptv
..def ..mnad
  io:aptv
  \ioarg \func \cont .ioarg \arg ..func arg cont
\io:mnad
# "$" functions like `$put` expect a continuation that takes no arguments, so
# we make wrappers of type `IO ()` that expect continuations that take a `unit`.
# similarly, functions like `$exit` expect no continuation, so we make wrappers
# of type `IO Void` that throw away the continuation.
..def \cont $exit \exit
..def \cont $err \#err # would shadow `err` the data constructor
..def $get \get
..def \bit \cont ..$put bit .cont unit \put
..def \bit \cont ..$eput bit .cont unit \eput
..def \term \cont ..$dump term .cont unit \dump
# we define a function `main` that takes an `IO ()` and invokes it with the
# continuation `\unit $exit`, throwing away the `unit` and returninng `$exit`
# to ultimately terminate the program
..def \iounit .iounit \unit $exit \main
# a hook that dumps the top-level term just before its effect is executed
..def \term ..$dump term term \$hook
..def \cont .$hook .cont unit \hook
..def \put ..bluebird
  ..sequence oct:tvsb io:aptv
  ..fmap oct:ftor put
\putc
..def \putc ..bluebird
  ..sequence list:tvsb io:aptv
  ..fmap list:ftor putc
\puts
..def \puts .undbg \argdebug \arg
  .puts ..argdebug arg nil
\putd
..def .putc eput  \eputc
..def .puts eputc \eputs
..def .putd eputs \eputd
..def .putc put  \putc
..def .puts putc \puts
..def .putd puts \putd
..def ...fmap io:ftor
  ..sequence oct:tvsb opt:aptv
  ...sequence oct:tvsb io:aptv
    ..pure oct:aptv get
\getc
..def .fix \gets
  ...bind io:mnad getc ..opt
    \chr ...fmap io:ftor .cons chr gets
    ..pure io:aptv nil
\gets
# read up to a terminator or EOF. include the terminator in the output, if any.
# EOF was hit if and only if the output doesn't end in the terminator
..def \to .fix \getto
  ...bind io:mnad getc ..opt
    \chr ...fmap io:ftor .cons chr
      .....unequal u8:eq to chr getto
        ..pure io:aptv nil
    ..pure io:aptv nil
\getto
# read up to a separator or EOF. don't include the separator in the output.
# there is no way to tell whether EOF was hit
..def \sep .fix \getsep
  ...bind io:mnad getc ..opt
    \chr .....unequal u8:eq sep chr
      ...fmap io:ftor .cons chr getsep
      ..pure io:aptv nil
    ..pure io:aptv nil
\getsep
