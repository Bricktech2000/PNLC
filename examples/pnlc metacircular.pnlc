# vim:tw=80:ft=pnlc:
# inc:../prelude.pnlc

# keep in sync with ../pnlc.c, 'pnlc definitional.pnlc', 'pnlc nbe.pnlc' and
# 'pnlc shallow.pnlc'

# meta-circular PNLC self-interpreter. 'meta-circular' in the sense that each
# feature of the object language is defined by using the corresponding feature
# of the host language (Reynolds, 1972). it can interpret itself. function
# application, lambda-abstraction, evaluation order, runtime errors are all
# stolen from the host runtime

..def ........listof seven
  ..pair .,$ .,e .,x .,i .,t nil $exit
  ..pair .,$ .,e .,r .,r     nil $err
  ..pair .,$ .,e .,m .,i .,t nil $emit
  ..pair .,$ .,g .,e .,t     nil $get
  ..pair .,$ .,p .,u .,t     nil $put
  ..pair .,$ .,e .,p .,u .,t nil $eput
  ..pair .,$ .,d .,u .,m .,p nil $dump
\ios

# type Ctx = List Prog
# app :: (Ctx -> Prog) -> (Ctx -> Prog) -> (Ctx -> Prog)
# lam :: (Ctx -> Prog) -> (Ctx -> Prog)
# var :: Nat -> (Ctx -> Prog)
..def \func \arg \ctx ..func ctx .arg ctx \app
..def \body      \ctx \arg .body ..cons arg ctx \lam
..def \idx       \ctx ...opt id $err ..index idx ctx \var

# type Env = List String
# wsp :: Parser String
# varp :: Parser String
# termp :: Env -> Parser Prog
..def ..many parser:altv .satp isspace \wsp
..def ...seql parser:aptv ..many1 parser:altv .unsatp isspace wsp \varp
..def .fix \termp \env
  ...alt parser:altv
    ...seqr parser:aptv .chrp '.'
    ...seqr parser:aptv wsp
    ....lifta2 parser:aptv app .termp env .termp env
  ...alt parser:altv
    ...seqr parser:aptv .chrp '\'
    ...seqr parser:aptv wsp
    ...bind parser:mnad varp \name
    ...fmap parser:ftor lam .termp ..cons name env
  ...alt parser:altv
    ...seqr parser:aptv .chrp '#'
    ...seqr parser:aptv ..many parser:altv .nonchrp '\n'
    ...seqr parser:aptv .chrp '\n'
    ...seqr parser:aptv wsp .termp env
  ...alt parser:altv
    ...bind parser:mnad varp \name
    .....memb byte:eq .,. .,\ .,# nil ...head name id '\0'
      .empty parser:altv
      .....elemindex str:eq name env
        ..bluebird .pure parser:aptv var
        .empty parser:altv
  .empty parser:altv
\termp

# parse :: Parser (IO Void)
..def ...fmap parser:ftor
  # `abort` here is noteworthy. it reshapes the parsed value from an opaque
  # `Prog` to an `IO Void` so it's compatible with the prelude's IO monad.
  \term .abort .term ...fmap list:ftor snd ios
  ....between parser:aptv wsp eofp
    .termp ...fmap list:ftor fst ios
\parse

# read characters from stdin until a '\0'. we use the character '\0' to end the
# program string and begin its execution
.main
  ...bind io:mnad .getsep '\0' \str ...parse str
    .unpair \prog \inp prog
    .eputs .,p .,a .,r .,s .,e .,  .,e .,r .,r .,o .,r .,\n nil
