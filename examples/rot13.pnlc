# vim:tw=80:ft=pnlc:
# inc:../prelude.pnlc

# given some character, is it in [a-mA-M]?
# ..def ..bluebird ...clamped byte:ord 'a' 'm' mklower \a-m
# ..def .unoct \o0 \o1 \o2 \o3 \o4 \o5 \o6 \o7
#   ..blt o7 ..and o6 ..blt o4 ..o3
#     ..ble o2 ..ble o1 false
#     ..or  o2 ..or  o1 ..or  o0 false
# \a-m

# given a character in [a-zA-Z], is it in [a-mA-M]?
# ..def ...becard isle ..compare byte:ord 'm' mklower \a-m
..def .unoct \o0 \o1 \o2 \o3 \o4 \o5 \o6 \o7
  ..blt o4 ..ble o3 ..ble o2 ..ble o1 false
\a-m

.main .callcc \break ..mforever io:mnad
  ...bind io:mnad getc ...cardinal opt .break unit \chr
    .putc ...not .isalpha chr chr .....a-m chr byte::add byte::sub '\r' chr
