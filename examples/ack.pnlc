# vim:tw=80:ft=pnlc:
# inc:../prelude.pnlc

# Ackermann function evaluated over a range of values: for `m = [0..)`, for
# `n = [0..inner)`, print `ack m n`. the function is evaluated over `Nat`s and
# so program output is correspondingly unary. the program gets OOM-killed at
# `ack 4 2 = 2^^5 - 3` (where ^^ is tetration). storing numbers in positional
# notation would not affect time complexity but would improve space complexity;
# still, it wouldn't get us very far: the program would get OOM-killed one step
# later at `ack 4 3 = 2^^6 - 3`

# ack :: Nat -> Nat -> Nat
# ack 0 n = n+1
# ack (m+1) 0 = ack m 1
# ack (m+1) (n+1) = ack m (ack (m+1) n)
..def .fix \ack \m \n
  ...cardinal m .some n \m
  ...cardinal n ..ack m one \n
                ..ack m ..ack .some m n
\ack

# ack :: Nat -> Nat -> Nat
# ack m = iterate f succ !! m
#   where f g n = iterate g 1 !! (n + 1)
..def .\f ..cata natf:ftor ..opt f some
  \g \n ...cata natf:ftor ..opt g one .some n
\ack

# the second definition above lends itself well to Church numerals:
..def \m ..m \g \n .g ..n g \f \x .f x \n \f \x .f ..n f x \ack
..def \n ..n some none \fromchurch
..def \n \f \x ...cata natf:ftor ..opt f x n \tochurch
..def ..blackbird fromchurch ..psi ack tochurch \ack


..def eight \inner

.main # `sequence` accumulates junk
  ...cata listf:ftor ..list .bindk io:mnad ..pure io:aptv unit
    ...fmap list:ftor .putd ..before:dbg :\n nat:dbg
      ....lifta2 list:aptv ack
        ..tolist stream:fldb ..iterate some none
        ..stake inner ..iterate some none
