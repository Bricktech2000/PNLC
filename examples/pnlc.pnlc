# vim:tw=80:ft=pnlc:
# inc:../prelude.pnlc

# keep in sync with ../pnlc.c

# data Typ = Exit | Err | Get | Put | Eput | Dump | One | Zero
..def \exit \err \get \put \eput \dump \one \zero exit \mkexit
..def \exit \err \get \put \eput \dump \one \zero err  \mkerr
..def \exit \err \get \put \eput \dump \one \zero get  \mkget
..def \exit \err \get \put \eput \dump \one \zero put  \mkput
..def \exit \err \get \put \eput \dump \one \zero eput \mkeput
..def \exit \err \get \put \eput \dump \one \zero dump \mkdump
..def \exit \err \get \put \eput \dump \one \zero one  \mkone
..def \exit \err \get \put \eput \dump \one \zero zero \mkzero
..def \exit \err \get \put \eput \dump \one \zero
  \typ ........typ exit err get put eput dump one zero
\typ
..def ........typ true false false false false false false false \isexit
..def ........typ false true false false false false false false \iserr
..def ........typ false false true false false false false false \isget
..def ........typ false false false true false false false false \isput
..def ........typ false false false false true false false false \iseput
..def ........typ false false false false false true false false \isdump
..def ........typ false false false false false false true false \isone
..def ........typ false false false false false false false true \iszero
..def .dbg ........typ :X :R :G :P :E :D :O :Z \typ:dbg
..def .seq ........typ id id id id id id id id \typ:seq
..def .enum
  ..cons mkzero
  ..cons mkone
  ..cons mkdump
  ..cons mkeput
  ..cons mkput
  ..cons mkget
  ..cons mkerr
  ..cons mkexit
  nil
\typ:enum
..def
  ..cons .:$ .:e .:x .:i .:t nil
  ..cons .:$ .:e .:r .:r     nil
  ..cons .:$ .:g .:e .:t     nil
  ..cons .:$ .:p .:u .:t     nil
  ..cons .:$ .:e .:p .:u .:t nil
  ..cons .:$ .:d .:u .:m .:p nil
  ..cons .:# .:o .:n .:e     nil
  ..cons .:# .:z .:e .:r .:o nil
  nil
\ios

# data Term = Mrk Term | App Term Term | Lam Term | Var Nat | Io Typ
..def \mrkd      \mrk \app \lam \var \io .mrk mrkd      \mrk
..def \func \arg \mrk \app \lam \var \io ..app func arg \app
..def \body      \mrk \app \lam \var \io .lam body      \lam
..def \idx       \mrk \app \lam \var \io .var idx       \var
..def \typ       \mrk \app \lam \var \io .io typ        \io
..def \mrk \app \lam \var \io \term .....term mrk app lam var io \term
..def .....term some     \func \arg none \body none \idx none \typ none \mrkd
..def .....term \mrkd nil  cons          \body nil  \idx nil  \typ nil  \unapp
..def .....term \mrkd none \f \a .some f \body none \idx none \typ none \func
..def .....term \mrkd none \f \a .some a \body none \idx none \typ none \arg
..def .....term \mrkd none \func \arg none some     \idx none \typ none \body
..def .....term \mrkd none \func \arg none \body none some    \typ none \idx
..def .....term \mrkd none \func \arg none \body none \idx none some    \typ
# the "base" functor for `Term`, with the property `Fix TermF = Term`.
# `data TermF a = App a a | Lam a | Var Nat | Io Typ deriving Functor`
..def .ftor
  \func .....term ..bluebird mrk func ..psi app func ..bluebird lam func var io
\termf:ftor
..def .dbg
  ..cata termf:ftor
    .....term .bluebird :# .becard :. .bluebird :\ .debug nat:dbg .debug typ:dbg
\term:dbg
# forcing appears to have become unnecessary.
..def .seq
  ..cata termf:ftor
    .....term id bluebird id .force nat:seq .force typ:seq
\term:seq

..def \term ...mrkd term id term \unmark
..def ..bluebird mrk unmark \mark

# beta :: Term -> Nat -> Term -> Term
..def \arg .fix \beta \lvl \term .....term
  mrk
  ..psi app .beta lvl
  ..bluebird lam .beta .some lvl
  ..bluebird
    ..bool .mark arg term
    ..equal nat:eq lvl
  io
\beta

# the left spine and head of the term returned have no `Mrk`s
# whnf :: Term -> Term
..def .fix \whnf \term
  ...unapp .unmark term
    \func \arg ..def .whnf func \func
      ...body func
        ..bluebird whnf ..beta arg none
        ..app func arg
    .unmark term
\whnf

# run :: Term -> IO Bool
..def .fix \run \term ..def .whnf term \term
  ...unapp term \func \cont
    ...unapp func \func \arg
      ...typ func \type
        ...isdump type
          .\dump ...bindk io:mnad .eputs dump .run cont
          ...debug term:dbg arg .:\n nil
        ......phi or isput iseput type
          ..def ...isput type put eput \put
          ...typ .whnf ..app ..app arg .io mkone .io mkzero \type
            ...isone  type ...bindk io:mnad .put true  .run cont
            ...iszero type ...bindk io:mnad .put false .run cont
            ..pure io:aptv false
          ..pure io:aptv false
        ..pure io:aptv false
      ..pure io:aptv false
    ...typ func \type
      ...isget type
        ...bind io:mnad get \optbit
          .\arg .run ..app cont arg
          .lam .lam ..optbit
            \bit ..app .var .some none .lam .lam .var ...bit some id none
            .var none
      ..pure io:aptv false
    ..pure io:aptv false
  ..pure io:aptv ...typ term isexit false
\run

# type Env = List String
# wsp :: Parser String
# varp :: Parser String
# termp :: Env -> Parser Term
..def ..many parser:altv .satp isspace \wsp
..def ...cardinal .seql parser:aptv wsp
  ..many1 parser:altv .satp ..bluebird not isspace
\varp
..def .fix \termp \env
  ...alt parser:altv
    ...seqr parser:aptv .chrp '.'
      ...seqr parser:aptv wsp
        ....lifta2 parser:aptv app .termp env .termp env
  ...alt parser:altv
    ...seqr parser:aptv .chrp '\'
      ...seqr parser:aptv wsp
        ...bind parser:mnad varp \name
          ...fmap parser:ftor lam .termp ..cons name env
  ...alt parser:altv
    ...seqr parser:aptv .chrp '#'
      ...seqr parser:aptv ..many parser:altv .nonchrp '\n'
        ...seqr parser:aptv .chrp '\n'
          ...seqr parser:aptv wsp .termp env
  ...alt parser:altv
    ...bind parser:mnad varp \name
      .....elem u8:eq ...head name id '\0' .:. .:\ .:# nil
        .kestrel .empty parser:altv
        .....elemindex .list:eq u8:eq name env
          ..bluebird .pure parser:aptv var
          .empty parser:altv
  .empty parser:altv
\termp

..def ...fmap parser:ftor
  \term ...cata listf:ftor
    ..list \typ \acc ..app .lam acc .io typ term
    .enumerate typ:enum
  ....between parser:aptv wsp eofp .termp ios
\parse

# read characters from stdin until a '\0'. we use the character '\0' to end the
# program string and begin its execution
.main
  ...bind io:mnad .getsep '\0' \str ...parse str
    .unpair \term \inp ...bind io:mnad .run term ..bool ..pure io:aptv unit
      .eputs .:r .:u .:n .:t .:i .:m .:e .:  .:e .:r .:r .:o .:r .:\n nil
    .eputs .:p .:a .:r .:s .:e .:  .:e .:r .:r .:o .:r .:\n nil
