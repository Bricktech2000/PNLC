# vim:tw=80:ft=pnlc:
# inc:../prelude.pnlc

# we also support a '#' instruction that outputs a neighborhood of the head to
# `stderr`. cells wrap at 256. the tape has unbounded length in both directions

# bfp :: Parser (Tape U8 -> IO (Tape U8))
# all the component parsers also have this type. this way, juxtaposition of
# Brainfuck program strings corresponds to `liftA2 (>=>)`, that is, penetration
# of parsers with Kleisli composition
..def .fix \bfp
  # bfp = liftA2 (>=>) atomp bfp <|> pure pure
  .\atomp ...alt parser:altv
    ....lifta2 parser:aptv .kleisli io:mnad atomp bfp
    ..pure parser:aptv .pure io:aptv
  # force the head of the tape before incrementing or decrementing its value and
  # before moving to another cell to avoid drowning in unfinished computations.
  ...alt parser:altv ...cardinal .fmapk parser:ftor .chrp '>'
    ..bluebird .pure io:aptv ...phi .force u8:seq fst leftshift
  ...alt parser:altv ...cardinal .fmapk parser:ftor .chrp '<'
    ..bluebird .pure io:aptv ...phi .force u8:seq fst rightshift
  ...alt parser:altv ...cardinal .fmapk parser:ftor .chrp '+'
    ..bluebird .pure io:aptv ..fmap swapa:ftor ..starling .force u8:seq u8::inc
  ...alt parser:altv ...cardinal .fmapk parser:ftor .chrp '-'
    ..bluebird .pure io:aptv ..fmap swapa:ftor ..starling .force u8:seq u8::dec
  ...alt parser:altv ...cardinal .fmapk parser:ftor .chrp '.'
    \tape ...fmapk io:ftor tape .putc .fst tape
  ...alt parser:altv ...cardinal .fmapk parser:ftor .chrp ','
    \tape ...cardinal .fmap io:ftor getc
      \optchr ...fmapk swapa:ftor ..optchr id '\0' tape
  ...alt parser:altv ...cardinal .fmapk parser:ftor .chrp '#'
    \tape ...fmapk io:ftor tape
      ..eputd ..before:dbg :\n ..tape:dbg eight u8::hex:dbg tape
  ...alt parser:altv ...cardinal .fmap parser:ftor
    ....between parser:aptv .chrp '[' .chrp ']' bfp
    \body .callccs \break ..kforever io:mnad
      \tape ......equal u8:eq '\0' .fst tape break body tape
  ...alt parser:altv ...cardinal .fmapk parser:ftor
    .unsatp ..memb u8:eq .:[ .:] nil
    .pure io:aptv
  .empty parser:altv
\bfp

# read characters from stdin until a '!'. we use the character '!' to separate
# the Brainfuck program from its input. that is, '!' ends a program string and
# begins its execution
.main
  ...bind io:mnad .getsep '!' \str
    ......seql parser:aptv bfp eofp str
      .unpair \prog \inp .prog ..pure tape:aptv '\0'
      .eputs .:p .:a .:r .:s .:e .:  .:e .:r .:r .:o .:r .:\n nil
